{
  "openapi": "3.0.3",
  "info": {
    "title": "Battle Reports API",
    "description": "API for managing battle reports from The Tower game",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:7071/api",
      "description": "Local development"
    },
    {
      "url": "https://your-function-app.azurewebsites.net/api",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Reports",
      "description": "Battle report management"
    },
    {
      "name": "Documentation",
      "description": "API documentation"
    }
  ],
  "paths": {
    "/reports": {
      "get": {
        "tags": ["Reports"],
        "summary": "Get user battle reports",
        "description": "Retrieve paginated battle reports for a specific user",
        "operationId": "getReports",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "example": "7E9CB1C14B2D1215"
            },
            "description": "User's unique identifier (16 characters)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of reports per page"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reports": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BattleReport"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": ["Reports"],
        "summary": "Create battle report",
        "description": "Parse and store a new battle report",
        "operationId": "createReport",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "raw_data"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 16,
                    "example": "7E9CB1C14B2D1215"
                  },
                  "raw_data": {
                    "type": "string",
                    "description": "Raw battle report text from the game",
                    "example": "Battle Report\\nBattle Date jan 08, 2026 17:56\\nTier 12\\nWave 8095..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Report saved successfully"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reports/{report_id}": {
      "delete": {
        "tags": ["Reports"],
        "summary": "Delete battle report",
        "description": "Delete a specific battle report",
        "operationId": "deleteReport",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Report unique identifier"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16
            },
            "description": "User's unique identifier"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Report deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Report deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["Documentation"],
        "summary": "API Documentation UI",
        "description": "Interactive Swagger UI (local only)",
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "HTML documentation page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BattleReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string"
          },
          "battle_date": {
            "type": "string",
            "format": "date-time"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "wave": {
            "type": "integer",
            "minimum": 1
          },
          "real_time": {
            "type": "string",
            "example": "10h 28m 3s"
          },
          "coins_earned": {
            "type": "number",
            "format": "double"
          },
          "cells_earned": {
            "type": "number",
            "format": "double"
          },
          "reroll_shards_earned": {
            "type": "number",
            "format": "double"
          },
          "damage_dealt": {
            "type": "number",
            "format": "double"
          },
          "killed_by": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication"
      }
    }
  }
}